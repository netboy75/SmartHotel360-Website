{
  "definition": {
    "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
    "contentVersion": "1.0.0.0",
    "parameters": {
      "$connections": {
        "defaultValue": {},
        "type": "Object"
      }
    },
    "triggers": {
      "manual": {
        "type": "Request",
        "kind": "Button",
        "inputs": {
          "schema": {
            "type": "object",
            "properties": {
              "text": {
                "title": "SharePoint Site URL",
                "type": "string",
                "x-ms-dynamically-added": true,
                "description": "Full URL of the target SharePoint site (e.g. https://contoso.sharepoint.com/sites/MySite)",
                "x-ms-content-hint": "TEXT"
              },
              "text_1": {
                "title": "Excel File Location (OneDrive path)",
                "type": "string",
                "x-ms-dynamically-added": true,
                "description": "OneDrive path to the Excel file (e.g. /Documents/ListColumnDefinitions.xlsx)",
                "x-ms-content-hint": "TEXT"
              },
              "text_2": {
                "title": "Excel Table Name",
                "type": "string",
                "x-ms-dynamically-added": true,
                "description": "Name of the Table inside the Excel file (e.g. ColumnDefinitions)",
                "x-ms-content-hint": "TEXT"
              }
            },
            "required": [
              "text",
              "text_1",
              "text_2"
            ]
          }
        }
      }
    },
    "actions": {
      "Initialize_CurrentListName": {
        "runAfter": {},
        "type": "InitializeVariable",
        "inputs": {
          "variables": [
            {
              "name": "CurrentListName",
              "type": "string",
              "value": ""
            }
          ]
        }
      },
      "Initialize_ListID": {
        "runAfter": {
          "Initialize_CurrentListName": [
            "Succeeded"
          ]
        },
        "type": "InitializeVariable",
        "inputs": {
          "variables": [
            {
              "name": "ListID",
              "type": "string",
              "value": ""
            }
          ]
        }
      },
      "Initialize_ErrorLog": {
        "runAfter": {
          "Initialize_ListID": [
            "Succeeded"
          ]
        },
        "type": "InitializeVariable",
        "inputs": {
          "variables": [
            {
              "name": "ErrorLog",
              "type": "array",
              "value": []
            }
          ]
        }
      },
      "List_rows_present_in_a_table": {
        "runAfter": {
          "Initialize_ErrorLog": [
            "Succeeded"
          ]
        },
        "type": "ApiConnection",
        "inputs": {
          "host": {
            "connection": {
              "name": "@parameters('$connections')['excelonlinebusiness']['connectionId']"
            }
          },
          "method": "get",
          "path": "/codeless/v1.2/drives/@{encodeURIComponent('me')}/items/@{encodeURIComponent(triggerBody()['text_1'])}/workbook/tables/@{encodeURIComponent(triggerBody()['text_2'])}/rows",
          "queries": {
            "$top": 5000
          }
        }
      },
      "Apply_to_each_row": {
        "runAfter": {
          "List_rows_present_in_a_table": [
            "Succeeded"
          ]
        },
        "type": "Foreach",
        "foreach": "@body('List_rows_present_in_a_table')?['value']",
        "actions": {
          "Compose_ListName": {
            "runAfter": {},
            "type": "Compose",
            "inputs": "@trim(items('Apply_to_each_row')?['ListName'])"
          },
          "Compose_ColumnName": {
            "runAfter": {},
            "type": "Compose",
            "inputs": "@trim(items('Apply_to_each_row')?['ColumnName'])"
          },
          "Compose_ColumnType": {
            "runAfter": {},
            "type": "Compose",
            "inputs": "@toLower(trim(items('Apply_to_each_row')?['ColumnType']))"
          },
          "Compose_ColumnDisplayName": {
            "runAfter": {},
            "type": "Compose",
            "inputs": "@trim(items('Apply_to_each_row')?['ColumnDisplayName'])"
          },
          "Compose_Required": {
            "runAfter": {},
            "type": "Compose",
            "inputs": "@toLower(trim(items('Apply_to_each_row')?['Required']))"
          },
          "Compose_Choices": {
            "runAfter": {},
            "type": "Compose",
            "inputs": "@trim(items('Apply_to_each_row')?['Choices'])"
          },
          "Condition_New_List": {
            "runAfter": {
              "Compose_ListName": ["Succeeded"],
              "Compose_ColumnName": ["Succeeded"],
              "Compose_ColumnType": ["Succeeded"],
              "Compose_ColumnDisplayName": ["Succeeded"],
              "Compose_Required": ["Succeeded"],
              "Compose_Choices": ["Succeeded"]
            },
            "type": "If",
            "expression": {
              "and": [
                {
                  "not": {
                    "equals": [
                      "@outputs('Compose_ListName')",
                      "@variables('CurrentListName')"
                    ]
                  }
                }
              ]
            },
            "actions": {
              "Create_SharePoint_List": {
                "runAfter": {},
                "type": "ApiConnection",
                "inputs": {
                  "host": {
                    "connection": {
                      "name": "@parameters('$connections')['sharepointonline']['connectionId']"
                    }
                  },
                  "method": "post",
                  "path": "/datasets/@{encodeURIComponent(encodeURIComponent(triggerBody()['text']))}/tables",
                  "body": {
                    "title": "@outputs('Compose_ListName')",
                    "templateType": 100
                  }
                }
              },
              "Set_ListID": {
                "runAfter": {
                  "Create_SharePoint_List": ["Succeeded"]
                },
                "type": "SetVariable",
                "inputs": {
                  "name": "ListID",
                  "value": "@body('Create_SharePoint_List')?['id']"
                }
              },
              "Set_CurrentListName": {
                "runAfter": {
                  "Set_ListID": ["Succeeded"]
                },
                "type": "SetVariable",
                "inputs": {
                  "name": "CurrentListName",
                  "value": "@outputs('Compose_ListName')"
                }
              },
              "Log_List_Created": {
                "runAfter": {
                  "Set_CurrentListName": ["Succeeded"]
                },
                "type": "AppendToArrayVariable",
                "inputs": {
                  "name": "ErrorLog",
                  "value": "✅ Created list: @{outputs('Compose_ListName')}"
                }
              }
            },
            "else": {
              "actions": {}
            }
          },
          "Skip_Title_Column": {
            "runAfter": {
              "Condition_New_List": ["Succeeded", "Skipped"]
            },
            "type": "If",
            "expression": {
              "and": [
                {
                  "equals": [
                    "@toLower(outputs('Compose_ColumnName'))",
                    "title"
                  ]
                }
              ]
            },
            "actions": {},
            "else": {
              "actions": {
                "Switch_ColumnType": {
                  "runAfter": {},
                  "type": "Switch",
                  "expression": "@outputs('Compose_ColumnType')",
                  "cases": {
                    "Case_Text": {
                      "case": "text",
                      "actions": {
                        "Add_Text_Field": {
                          "runAfter": {},
                          "type": "ApiConnection",
                          "inputs": {
                            "host": {
                              "connection": {
                                "name": "@parameters('$connections')['sharepointonline']['connectionId']"
                              }
                            },
                            "method": "post",
                            "path": "/datasets/@{encodeURIComponent(encodeURIComponent(triggerBody()['text']))}/tables/@{encodeURIComponent(variables('ListID'))}/fields",
                            "body": {
                              "__metadata": {
                                "type": "SP.FieldText"
                              },
                              "FieldTypeKind": 2,
                              "Title": "@outputs('Compose_ColumnDisplayName')",
                              "StaticName": "@outputs('Compose_ColumnName')",
                              "Required": "@if(equals(outputs('Compose_Required'),'yes'),true,false)"
                            }
                          }
                        }
                      }
                    },
                    "Case_Number": {
                      "case": "number",
                      "actions": {
                        "Add_Number_Field": {
                          "runAfter": {},
                          "type": "ApiConnection",
                          "inputs": {
                            "host": {
                              "connection": {
                                "name": "@parameters('$connections')['sharepointonline']['connectionId']"
                              }
                            },
                            "method": "post",
                            "path": "/datasets/@{encodeURIComponent(encodeURIComponent(triggerBody()['text']))}/tables/@{encodeURIComponent(variables('ListID'))}/fields",
                            "body": {
                              "__metadata": {
                                "type": "SP.FieldNumber"
                              },
                              "FieldTypeKind": 9,
                              "Title": "@outputs('Compose_ColumnDisplayName')",
                              "StaticName": "@outputs('Compose_ColumnName')",
                              "Required": "@if(equals(outputs('Compose_Required'),'yes'),true,false)"
                            }
                          }
                        }
                      }
                    },
                    "Case_DateTime": {
                      "case": "datetime",
                      "actions": {
                        "Add_DateTime_Field": {
                          "runAfter": {},
                          "type": "ApiConnection",
                          "inputs": {
                            "host": {
                              "connection": {
                                "name": "@parameters('$connections')['sharepointonline']['connectionId']"
                              }
                            },
                            "method": "post",
                            "path": "/datasets/@{encodeURIComponent(encodeURIComponent(triggerBody()['text']))}/tables/@{encodeURIComponent(variables('ListID'))}/fields",
                            "body": {
                              "__metadata": {
                                "type": "SP.FieldDateTime"
                              },
                              "FieldTypeKind": 4,
                              "Title": "@outputs('Compose_ColumnDisplayName')",
                              "StaticName": "@outputs('Compose_ColumnName')",
                              "Required": "@if(equals(outputs('Compose_Required'),'yes'),true,false)"
                            }
                          }
                        }
                      }
                    },
                    "Case_Boolean": {
                      "case": "boolean",
                      "actions": {
                        "Add_Boolean_Field": {
                          "runAfter": {},
                          "type": "ApiConnection",
                          "inputs": {
                            "host": {
                              "connection": {
                                "name": "@parameters('$connections')['sharepointonline']['connectionId']"
                              }
                            },
                            "method": "post",
                            "path": "/datasets/@{encodeURIComponent(encodeURIComponent(triggerBody()['text']))}/tables/@{encodeURIComponent(variables('ListID'))}/fields",
                            "body": {
                              "__metadata": {
                                "type": "SP.FieldBoolean"
                              },
                              "FieldTypeKind": 8,
                              "Title": "@outputs('Compose_ColumnDisplayName')",
                              "StaticName": "@outputs('Compose_ColumnName')",
                              "Required": "@if(equals(outputs('Compose_Required'),'yes'),true,false)"
                            }
                          }
                        }
                      }
                    },
                    "Case_Choice": {
                      "case": "choice",
                      "actions": {
                        "Compose_ChoicesArray": {
                          "runAfter": {},
                          "type": "Compose",
                          "inputs": "@split(outputs('Compose_Choices'), ',')"
                        },
                        "Add_Choice_Field": {
                          "runAfter": {
                            "Compose_ChoicesArray": ["Succeeded"]
                          },
                          "type": "ApiConnection",
                          "inputs": {
                            "host": {
                              "connection": {
                                "name": "@parameters('$connections')['sharepointonline']['connectionId']"
                              }
                            },
                            "method": "post",
                            "path": "/datasets/@{encodeURIComponent(encodeURIComponent(triggerBody()['text']))}/tables/@{encodeURIComponent(variables('ListID'))}/fields",
                            "body": {
                              "__metadata": {
                                "type": "SP.FieldChoice"
                              },
                              "FieldTypeKind": 6,
                              "Title": "@outputs('Compose_ColumnDisplayName')",
                              "StaticName": "@outputs('Compose_ColumnName')",
                              "Required": "@if(equals(outputs('Compose_Required'),'yes'),true,false)",
                              "Choices": {
                                "results": "@outputs('Compose_ChoicesArray')"
                              }
                            }
                          }
                        }
                      }
                    },
                    "Case_MultiChoice": {
                      "case": "multichoice",
                      "actions": {
                        "Compose_MultiChoicesArray": {
                          "runAfter": {},
                          "type": "Compose",
                          "inputs": "@split(outputs('Compose_Choices'), ',')"
                        },
                        "Add_MultiChoice_Field": {
                          "runAfter": {
                            "Compose_MultiChoicesArray": ["Succeeded"]
                          },
                          "type": "ApiConnection",
                          "inputs": {
                            "host": {
                              "connection": {
                                "name": "@parameters('$connections')['sharepointonline']['connectionId']"
                              }
                            },
                            "method": "post",
                            "path": "/datasets/@{encodeURIComponent(encodeURIComponent(triggerBody()['text']))}/tables/@{encodeURIComponent(variables('ListID'))}/fields",
                            "body": {
                              "__metadata": {
                                "type": "SP.FieldMultiChoice"
                              },
                              "FieldTypeKind": 15,
                              "Title": "@outputs('Compose_ColumnDisplayName')",
                              "StaticName": "@outputs('Compose_ColumnName')",
                              "Required": "@if(equals(outputs('Compose_Required'),'yes'),true,false)",
                              "Choices": {
                                "results": "@outputs('Compose_MultiChoicesArray')"
                              }
                            }
                          }
                        }
                      }
                    },
                    "Case_Note": {
                      "case": "note",
                      "actions": {
                        "Add_Note_Field": {
                          "runAfter": {},
                          "type": "ApiConnection",
                          "inputs": {
                            "host": {
                              "connection": {
                                "name": "@parameters('$connections')['sharepointonline']['connectionId']"
                              }
                            },
                            "method": "post",
                            "path": "/datasets/@{encodeURIComponent(encodeURIComponent(triggerBody()['text']))}/tables/@{encodeURIComponent(variables('ListID'))}/fields",
                            "body": {
                              "__metadata": {
                                "type": "SP.FieldMultiLineText"
                              },
                              "FieldTypeKind": 3,
                              "Title": "@outputs('Compose_ColumnDisplayName')",
                              "StaticName": "@outputs('Compose_ColumnName')",
                              "Required": "@if(equals(outputs('Compose_Required'),'yes'),true,false)"
                            }
                          }
                        }
                      }
                    },
                    "Case_Currency": {
                      "case": "currency",
                      "actions": {
                        "Add_Currency_Field": {
                          "runAfter": {},
                          "type": "ApiConnection",
                          "inputs": {
                            "host": {
                              "connection": {
                                "name": "@parameters('$connections')['sharepointonline']['connectionId']"
                              }
                            },
                            "method": "post",
                            "path": "/datasets/@{encodeURIComponent(encodeURIComponent(triggerBody()['text']))}/tables/@{encodeURIComponent(variables('ListID'))}/fields",
                            "body": {
                              "__metadata": {
                                "type": "SP.FieldCurrency"
                              },
                              "FieldTypeKind": 10,
                              "Title": "@outputs('Compose_ColumnDisplayName')",
                              "StaticName": "@outputs('Compose_ColumnName')",
                              "Required": "@if(equals(outputs('Compose_Required'),'yes'),true,false)"
                            }
                          }
                        }
                      }
                    },
                    "Case_URL": {
                      "case": "url",
                      "actions": {
                        "Add_URL_Field": {
                          "runAfter": {},
                          "type": "ApiConnection",
                          "inputs": {
                            "host": {
                              "connection": {
                                "name": "@parameters('$connections')['sharepointonline']['connectionId']"
                              }
                            },
                            "method": "post",
                            "path": "/datasets/@{encodeURIComponent(encodeURIComponent(triggerBody()['text']))}/tables/@{encodeURIComponent(variables('ListID'))}/fields",
                            "body": {
                              "__metadata": {
                                "type": "SP.FieldUrl"
                              },
                              "FieldTypeKind": 11,
                              "Title": "@outputs('Compose_ColumnDisplayName')",
                              "StaticName": "@outputs('Compose_ColumnName')",
                              "Required": "@if(equals(outputs('Compose_Required'),'yes'),true,false)"
                            }
                          }
                        }
                      }
                    }
                  },
                  "default": {
                    "actions": {
                      "Log_Unknown_Type": {
                        "runAfter": {},
                        "type": "AppendToArrayVariable",
                        "inputs": {
                          "name": "ErrorLog",
                          "value": "⚠️ Unknown ColumnType '@{outputs('Compose_ColumnType')}' for column '@{outputs('Compose_ColumnName')}' in list '@{outputs('Compose_ListName')}' — skipped."
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "runtimeConfiguration": {
          "concurrency": {
            "repetitions": 1
          }
        }
      },
      "Compose_Summary": {
        "runAfter": {
          "Apply_to_each_row": ["Succeeded", "Failed", "Skipped"]
        },
        "type": "Compose",
        "inputs": {
          "Status": "Flow completed",
          "Log": "@variables('ErrorLog')"
        }
      },
      "Terminate_Success": {
        "runAfter": {
          "Compose_Summary": ["Succeeded"]
        },
        "type": "Terminate",
        "inputs": {
          "runStatus": "Succeeded",
          "runError": {
            "code": "200",
            "message": "All SharePoint lists created successfully. Check ErrorLog for any skipped columns."
          }
        }
      }
    },
    "outputs": {}
  },
  "connectionReferences": {
    "excelonlinebusiness": {
      "runtimeSource": "embedded",
      "connection": {
        "connectionReferenceLogicalName": "cr_excelonlinebusiness"
      },
      "api": {
        "name": "shared_excelonlinebusiness"
      }
    },
    "sharepointonline": {
      "runtimeSource": "embedded",
      "connection": {
        "connectionReferenceLogicalName": "cr_sharepointonline"
      },
      "api": {
        "name": "shared_sharepointonline"
      }
    }
  }
}
